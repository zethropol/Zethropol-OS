{
  "document_kind": "collector-artifact-planning-sidecar",
  "scope": "workspace design only; not a validator capture or acceptance authority",
  "host_execution_performed": false,
  "accepted_user_evidence": {
    "role": "manifest signer UID949/GID948",
    "native_socket": "/var/lib/zethropol-aur-release/gnupg/S.gpg-agent",
    "source": "current user supplied host verification",
    "repeat_probe": false,
    "credential_readiness": "NOT_PROBED"
  },
  "gate_status": {
    "native_domain_trust": "BLOCKED",
    "independent_rebuild_receipt": "BLOCKED",
    "complete_300_second_path": "BLOCKED",
    "runtime_acceptance": "BLOCKED"
  },
  "planned_artifacts": [
    {
      "gate": "native_domain_trust",
      "producer": "future disposable fixed-domain native loader; no transaction",
      "planned_path": "native/domain-start.raw",
      "bind_to": [
        "operation_id",
        "package_sha256",
        "aur_snapshot_sha256",
        "official_dependency_snapshot_sha256",
        "official_repository_metadata_sha256"
      ],
      "consumer": "native_domain_acceptance.validate_admission_capture",
      "independent_authority_required": true
    },
    {
      "gate": "complete_300_second_path",
      "producer": "original server reservation plus provider boundary collector",
      "planned_path": "budget/original-reservation-and-boundaries.raw",
      "bind_to": [
        "boot_id",
        "CLOCK_BOOTTIME",
        "CLOCK_REALTIME",
        "original issued/deadline",
        "prepare/rebuild/sign/attach/receipt/publish/admission boundaries"
      ],
      "consumer": "rebuild_acceptance.RuntimeBudget and validate_budget",
      "lifetime_seconds": 300,
      "extend_or_rebase": false
    },
    {
      "gate": "independent_rebuild_receipt",
      "producer": "separate Archive UID951 and Receipt/Attestor UID950 collectors",
      "planned_path": "roles/{archive,attestor}/process-context.raw",
      "bind_to": [
        "kernel real/effective/saved/fs UID/GID",
        "Groups",
        "PID/starttime",
        "uid_map/gid_map",
        "fresh work/cache identities",
        "root provenance",
        "output/metadata/cleanup"
      ],
      "consumer": "protected collector sidecar; selected existing fields feed validate_rebuild without schema extension",
      "uid949_evidence_substitution_allowed": false
    },
    {
      "gate": "runtime_acceptance",
      "case": "JOURNAL-ISOLATION",
      "producer": "future disposable guest worker collector",
      "planned_paths": {
        "mount-layout": "runtime/journal-isolation/mount-layout.raw",
        "worker-namespace": "runtime/journal-isolation/worker-namespace.raw",
        "journal-fsync": "runtime/journal-isolation/journal-fsync.raw"
      },
      "bind_to": [
        "vm_id",
        "boot_id",
        "current source_sha256",
        "worker PID/starttime"
      ],
      "consumer": "runtime_acceptance.validate_capture evidence roles",
      "namespace_free_gpg_probe_substitution_allowed": false
    },
    {
      "gate": "runtime_acceptance",
      "case": "WORKER-CANCEL-TIMEOUT",
      "producer": "future disposable guest cancellation/timeout collector",
      "planned_paths": {
        "cgroup-processes": "runtime/worker-cancel-timeout/cgroup-processes.raw",
        "journal-cleanup": "runtime/worker-cancel-timeout/journal-cleanup.raw"
      },
      "bind_to": [
        "vm_id",
        "boot_id",
        "current source_sha256",
        "worker PID/starttime",
        "exact cgroup path",
        "cgroup.procs and cgroup.events before/after cancellation",
        "same journal operation/lease and cleanup outcome"
      ],
      "consumer": "runtime_acceptance.validate_capture evidence roles",
      "uid949_socket_metadata_substitution_allowed": false,
      "measurements_performed": false
    }
  ],
  "safety": {
    "agent_start": false,
    "signing": false,
    "private_key_use": false,
    "host_mutation": false,
    "old_approval_pending_nonce_audit_reuse": false,
    "production_enable": false
  }
}
