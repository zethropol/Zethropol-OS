import os,pathlib,subprocess,signal,time,json
assert pathlib.Path('/sys/class/dmi/id/product_uuid').read_text().strip()=='c98f6c9a-a516-45f3-bfe9-ad78c712b54b'
b=pathlib.Path('/var/lib/zethropol/aur-journal/evidence')
a=pathlib.Path('/usr/bin/ccmake');z=pathlib.Path('/usr/share/vim/vimfiles/syntax/cmake.vim');old=a.stat();tail=z.stat()
assert not pathlib.Path('/var/lib/pacman/db.lck').exists()
log=(b/'power-loss-native.raw').open('xb')
p=subprocess.Popen(['pacman','-U','--noconfirm','/opt/aur-acceptance/packages/cmake-4.4.3-2.1-x86_64_v3.pkg.tar.zst'],stdout=log,stderr=subprocess.STDOUT,start_new_session=True,stdin=subprocess.DEVNULL)
end=time.monotonic()+25
while time.monotonic()<end:
 try:current=a.stat()
 except FileNotFoundError:continue
 if current.st_ino!=old.st_ino or current.st_ctime_ns!=old.st_ctime_ns:
  os.kill(p.pid,signal.SIGSTOP);_,state=os.waitpid(p.pid,os.WUNTRACED);assert os.WIFSTOPPED(state)
  f=a.stat();last=z.stat() if z.exists() else None
  assert last is None or last.st_ctime_ns==tail.st_ctime_ns
  row={'scope':'real guest distribution ALPM mechanism; not AUR authority','observer_pid':os.getpid(),'pacman_pid':p.pid,'native_process_stopped':True,'first_payload':str(a),'first_size':f.st_size,'expected_first_size':old.st_size,'last_payload':str(z),'last_missing':last is None,'last_unchanged':last is not None and last.st_ctime_ns==tail.st_ctime_ns,'db_lock':pathlib.Path('/var/lib/pacman/db.lck').exists(),'boot_id':pathlib.Path('/proc/sys/kernel/random/boot_id').read_text().strip()}
  fd=os.open(b/'power-loss-window.json',os.O_WRONLY|os.O_CREAT|os.O_EXCL,0o600);os.write(fd,json.dumps(row,sort_keys=True).encode());os.fsync(fd);os.close(fd)
  fd=os.open(b,os.O_DIRECTORY);os.fsync(fd);os.close(fd)
  print(json.dumps(row),flush=True)
  while True:signal.pause()
 if p.poll() is not None:raise RuntimeError('Partial window not observed')
 time.sleep(.0005)
raise RuntimeError('Partial window deadline expired')
