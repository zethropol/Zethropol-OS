[Unit]
Description=Zethropol UID949 native home socket agent supervisor
StartLimitIntervalSec=300
StartLimitBurst=1

[Service]
Type=notify
NotifyAccess=main
User=zethropol-aur-release
Group=zethropol-aur-release
SupplementaryGroups=
UMask=0077
WorkingDirectory=/var/lib/zethropol-aur-release
ExecStartPre=+/usr/bin/python3 -I -S -B /usr/lib/zethropol/aur-agent-lifecycle-949/releases/home-route-v2-20261103/agent_lifecycle_949.py root-claim
ExecStart=/usr/bin/python3 -I -S -B /usr/lib/zethropol/aur-agent-lifecycle-949/releases/home-route-v2-20261103/agent_lifecycle_949.py run
Restart=no
KillMode=mixed
TimeoutStartSec=40
TimeoutStopSec=20
LimitCORE=0
TasksMax=32
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
StandardOutput=journal
StandardError=null
