[Unit]
Description=Zethropol AUR trusted delivery publisher %i
After=zethropol-update.service
[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/bin/python3 -I -B /usr/lib/zethropol/aur/provider.py prepare %i
ExecStart=/usr/bin/systemctl start --wait zethropol-aur-sign@%i.service
ExecStart=/usr/bin/python3 -I -B /usr/lib/zethropol/aur/provider.py attach %i
ExecStart=/usr/bin/systemctl start --wait zethropol-aur-attest@%i.service
ExecStart=/usr/bin/python3 -I -B /usr/lib/zethropol/aur/provider.py publish %i
Restart=no
TimeoutStartSec=4000
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/zethropol/aur-deliveries /var/lib/zethropol/aur-provider-jobs
PrivateTmp=yes
