[Unit]
Description=Zethropol AUR developer output signing %i
[Service]
Type=oneshot
User=zethropol-aur-archive
Group=zethropol-aur-archive
SupplementaryGroups=zethropol-aur-providers
UMask=0077
PAMName=login
ExecStart=/usr/bin/python3 -I -B /usr/lib/zethropol/aur/provider.py sign-build %i
ExecStopPost=/usr/bin/python3 -I -B /usr/lib/zethropol/aur/provider.py recover-archive %i
Restart=no
TimeoutStartSec=1900
TimeoutStopSec=45
KillMode=mixed
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/zethropol-aur-archive
ReadWritePaths=-/run/user
PrivateTmp=yes
