<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>
  <action id="org.zethropol.updates.apply">
    <description>Apply Zethropol official system updates or remove orphan packages</description>
    <message>Authentication is required to create a Snapper recovery snapshot and apply official system updates or remove orphan packages.</message>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/zethropol/zethropol-update-helper</annotate>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
</policyconfig>
