set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR i686)

set(TOOLCHAIN_PREFIX i686-w64-mingw32)

if (DEFINED LLVM_MINGW_ROOT AND EXISTS "${LLVM_MINGW_ROOT}/bin/${TOOLCHAIN_PREFIX}-clang++")
    set(CMAKE_C_COMPILER "${LLVM_MINGW_ROOT}/bin/${TOOLCHAIN_PREFIX}-clang")
    set(CMAKE_CXX_COMPILER "${LLVM_MINGW_ROOT}/bin/${TOOLCHAIN_PREFIX}-clang++")
    set(CMAKE_RC_COMPILER "${LLVM_MINGW_ROOT}/bin/${TOOLCHAIN_PREFIX}-windres")
    set(CMAKE_AR "${LLVM_MINGW_ROOT}/bin/${TOOLCHAIN_PREFIX}-ar")
    set(CMAKE_RANLIB "${LLVM_MINGW_ROOT}/bin/${TOOLCHAIN_PREFIX}-ranlib")
    set(CMAKE_FIND_ROOT_PATH "${LLVM_MINGW_ROOT}/${TOOLCHAIN_PREFIX}")
else()
    set(CMAKE_C_COMPILER ${TOOLCHAIN_PREFIX}-gcc)
    set(CMAKE_CXX_COMPILER ${TOOLCHAIN_PREFIX}-g++)
    set(CMAKE_RC_COMPILER ${TOOLCHAIN_PREFIX}-windres)
    set(CMAKE_AR ${TOOLCHAIN_PREFIX}-ar)
    set(CMAKE_RANLIB ${TOOLCHAIN_PREFIX}-ranlib)
    set(CMAKE_FIND_ROOT_PATH /usr/${TOOLCHAIN_PREFIX})
endif()

set(CMAKE_C_FLAGS_INIT "-march=i686 -mtune=generic -D_WIN32_WINNT=0x0601 -DWINVER=0x0601")
set(CMAKE_CXX_FLAGS_INIT "-march=i686 -mtune=generic -D_WIN32_WINNT=0x0601 -DWINVER=0x0601")

set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
