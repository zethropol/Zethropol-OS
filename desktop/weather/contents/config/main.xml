<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0 http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
  <kcfgfile name=""/>
  <group name="General">
    <entry name="locationName" type="String">
      <label>Konum adı</label>
      <default>İstanbul</default>
    </entry>
    <entry name="locationAdmin" type="String">
      <label>İl / Ülke açıklaması</label>
      <default>İstanbul, Türkiye</default>
    </entry>
    <entry name="countryCode" type="String">
      <label>Ülke kodu (ISO-2)</label>
      <default>TR</default>
    </entry>
    <entry name="latitude" type="Double">
      <label>Enlem</label>
      <default>41.0082</default>
    </entry>
    <entry name="longitude" type="Double">
      <label>Boylam</label>
      <default>28.9784</default>
    </entry>
    <entry name="forecastDays" type="Int">
      <label>Günlük tahmin aralığı (3, 5 veya 7 gün)</label>
      <default>5</default>
      <min>3</min>
      <max>7</max>
    </entry>
    <entry name="desktopOpacity" type="Int">
      <label>Masaüstü kartı opaklığı (%)</label>
      <default>82</default>
      <min>15</min>
      <max>100</max>
    </entry>
    <entry name="popupOpacity" type="Int">
      <label>Açılır pencere arka plan opaklığı (%)</label>
      <default>92</default>
      <min>15</min>
      <max>100</max>
    </entry>
    <entry name="useCustomGlassBackground" type="Bool">
      <label>Özel Zethropol cam arka plan katmanını kullan (NoBackground)</label>
      <default>true</default>
    </entry>
    <entry name="useMgmObservation" type="Bool">
      <label>Türkiye konumlarında MGM anlık gözlem verisini kullan</label>
      <default>true</default>
    </entry>
    <entry name="refreshIntervalMinutes" type="Int">
      <label>Otomatik yenileme aralığı (dakika)</label>
      <default>15</default>
      <min>5</min>
      <max>120</max>
    </entry>
  </group>
</kcfg>
