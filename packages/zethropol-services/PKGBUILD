pkgname=zethropol-services
pkgver=0.1.0
pkgrel=1
pkgdesc="Zethropol Services D-Bus service"
url="https://github.com/zethropol/Zethropol-OS"
arch=("x86_64")
license=("MIT")
depends=("glibc" "dbus" "systemd")
makedepends=("cargo")
_commit=c41ff578cff2d158180e05c39445b6207778442b
source=("git+https://github.com/zethropol/Zethropol-OS.git#commit=$_commit")
sha256sums=("SKIP")

build() {
    cd "$srcdir/Zethropol-OS/services/services"
    cargo build --release --locked
}

package() {
    cd "$srcdir/Zethropol-OS/services/services"

    install -Dm755 "target/release/services"         "$pkgdir/usr/lib/zethropol/zethropol-services"

    install -Dm644 "deployment/dbus/org.zethropol.Services.conf"         "$pkgdir/etc/dbus-1/system.d/org.zethropol.Services.conf"

    install -Dm644 "deployment/dbus/org.zethropol.Services.service"         "$pkgdir/usr/share/dbus-1/system-services/org.zethropol.Services.service"

    install -Dm644 "deployment/systemd/zethropol-services.service"         "$pkgdir/usr/lib/systemd/system/zethropol-services.service"
}
