pkgname=zethropol-services
pkgver=0.1.0
pkgrel=3
pkgdesc="Zethropol Services D-Bus service"
url="https://github.com/zethropol/Zethropol-OS"
arch=("x86_64")
license=("MIT")
depends=("glibc" "gcc-libs" "dbus" "systemd" "polkit")
makedepends=("cargo")
source=("${pkgname}-${pkgver}-${pkgrel}-src.tar.gz")
sha256sums=("bdf9f6cea31a4f046b9b05af8edf427ccb471f7d2ee4607fc2351a74d2e0aaf1")

build() {
    cd "$srcdir/${pkgname}-${pkgver}/services/services"
    export RUSTFLAGS="--remap-path-prefix=${CARGO_HOME:-$HOME/.cargo}=/cargo --remap-path-prefix=${HOME}=/home/build --remap-path-prefix=${srcdir}=/build ${RUSTFLAGS:-}"
    cargo build --release --locked --offline
}

check() {
    cd "$srcdir/${pkgname}-${pkgver}/services/services"
    export RUSTFLAGS="--remap-path-prefix=${CARGO_HOME:-$HOME/.cargo}=/cargo --remap-path-prefix=${HOME}=/home/build --remap-path-prefix=${srcdir}=/build ${RUSTFLAGS:-}"
    cargo test --locked --offline
}

package() {
    cd "$srcdir/${pkgname}-${pkgver}/services/services"

    install -Dm755 target/release/services "$pkgdir/usr/lib/zethropol/zethropol-services"
    install -Dm644 deployment/dbus/org.zethropol.Services.conf "$pkgdir/etc/dbus-1/system.d/org.zethropol.Services.conf"
    install -Dm644 deployment/dbus/org.zethropol.Services.service "$pkgdir/usr/share/dbus-1/system-services/org.zethropol.Services.service"
    install -Dm644 deployment/systemd/zethropol-services.service "$pkgdir/usr/lib/systemd/system/zethropol-services.service"
    install -Dm644 deployment/polkit/org.zethropol.services.policy "$pkgdir/usr/share/polkit-1/actions/org.zethropol.services.policy"
    install -Dm644 "$srcdir/${pkgname}-${pkgver}/LICENSE" "$pkgdir/usr/share/licenses/${pkgname}/LICENSE"
}
