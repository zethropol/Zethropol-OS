[Unit]
Description=Zethropol Power D-Bus Service
After=dbus.socket
BindsTo=dbus.socket

[Service]
Type=dbus
BusName=org.zethropol.Power
ExecStart=/usr/lib/zethropol/zethropol-power
Restart=on-failure
RestartSec=2s
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/sys/devices/system/cpu/cpufreq
ProtectHome=true
PrivateDevices=true
ProtectKernelModules=true
ProtectControlGroups=true
NoNewPrivileges=true
RestrictAddressFamilies=AF_UNIX
LockPersonality=true
