[Unit]
Description=Zethropol Recovery D-Bus Service
After=dbus.socket
BindsTo=dbus.socket

[Service]
Type=dbus
BusName=org.zethropol.Recovery
ExecStart=/usr/lib/zethropol/zethropol-recovery
Restart=on-failure
RestartSec=2s
PrivateTmp=true
ProtectSystem=full
CapabilityBoundingSet=~CAP_SYS_MODULE
SystemCallFilter=~@module
ProtectControlGroups=true
NoNewPrivileges=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
