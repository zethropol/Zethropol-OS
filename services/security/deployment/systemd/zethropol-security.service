[Unit]
Description=Zethropol Security & ZCI Policy D-Bus Service
After=dbus.socket
BindsTo=dbus.socket

[Service]
Type=dbus
BusName=org.zethropol.Security
ExecStart=/usr/lib/zethropol/zethropol-security
Restart=on-failure
RestartSec=2s
PrivateTmp=true
ProtectSystem=strict
StateDirectory=zethropol-security
StateDirectoryMode=0700
LogsDirectory=zethropol-security
LogsDirectoryMode=0750
ReadWritePaths=-/etc/ufw
ProtectHome=true
PrivateDevices=true
ProtectKernelModules=true
ProtectControlGroups=true
NoNewPrivileges=true
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
