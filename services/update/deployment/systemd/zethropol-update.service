[Unit]
Description=Zethropol OS Update D-Bus Service
After=dbus.socket network-online.target
BindsTo=dbus.socket

[Service]
Type=dbus
BusName=org.zethropol.Update
ExecStart=/usr/lib/zethropol/zethropol-update
User=root
Group=root
Restart=on-failure
RestartSec=2s
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/usr /boot -/efi
ProtectHome=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectControlGroups=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
