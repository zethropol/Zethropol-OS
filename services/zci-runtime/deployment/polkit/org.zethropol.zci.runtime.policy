<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "https://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>
  <action id="org.zethropol.zci.runtime.load">
    <description>Load or unload verified local AI models in Zethropol ZCI Runtime</description>
    <message>Administrator authentication is required to load or unload local AI models in ZCI Runtime.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="org.zethropol.zci.runtime.admin">
    <description>Administer Zethropol ZCI Runtime manifest, configuration, and standby state</description>
    <message>Administrator authentication is required to reload the ZCI model manifest or change runtime standby state.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
</policyconfig>
